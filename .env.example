# Copy this file to .env and fill in your credentials.
# Never commit .env — it is listed in .gitignore.

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Slack (optional — Stage notifications) ────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_PRD_CHANNEL=#devforge-prd

# ── Linear (optional — task tracking) ────────────────────────────────────────
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── GitHub (optional — Stage 6 deploy / PR creation) ─────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-username/your-output-repo

# ── Google OAuth (optional — Gmail SSO button in dashboard) ───────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://your-domain.com/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
APP_BASE_URL=http://localhost:8000

# ── GitHub OAuth App (optional — GitHub SSO button in dashboard) ──────────────
# Create at https://github.com/settings/developers → "New OAuth App"
# Callback URL: https://your-domain.com/auth/github/callback
# Note: these are DIFFERENT from GITHUB_TOKEN (PAT) above
GITHUB_CLIENT_ID=Ov23li...
GITHUB_CLIENT_SECRET=your-github-oauth-secret
